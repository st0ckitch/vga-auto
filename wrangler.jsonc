{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vga-auto",
  "main": "worker/admin-proxy.js",
  "compatibility_date": "2026-10-06",
  "observability": { "enabled": true },
  // required by `wrangler preview`, which Cloudflare runs for non-production branches
  "previews": {},
  // the site is copied into dist/ first so that .git and tooling never reach the upload
  "build": { "command": "node worker/stage-assets.js" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // paths the Worker must see before the asset router (otherwise unmatched
    // requests get the 404 page and the Worker never runs): admin API + old-site addresses
    "run_worker_first": ["/api/*", "/vg", "/vg/*", "/VG", "/VG/*", "/en/vg", "/en/vg/*", "/ru/vg", "/ru/vg/*", "/index.php", "/en/index.php", "/ru/index.php", "/dlr", "/dlr/*", "/en/dlr", "/en/dlr/*", "/ru/dlr", "/ru/dlr/*"]
  }
}
